{
  "name": "douyin-downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -k -n vite,cf -c cyan,magenta \"vite --host 127.0.0.1 --port 5173\" \"wrangler pages dev dist --proxy 5173 --port 8788\"",
    "build": "vite build",
    "preview": "wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^3.101.0"
  }
}
